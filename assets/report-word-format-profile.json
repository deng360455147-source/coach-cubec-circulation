{
  "schema_version": "1.1",
  "profile_name": "cubec-a4-chinese-research-print",
  "basis": "用户上传版式参考图；当届细则、学校模板或用户后续明确要求优先",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins_cm": {
      "top": 2.54,
      "bottom": 2.54,
      "left": 3.17,
      "right": 3.17
    },
    "header_distance_cm": 1.5,
    "footer_distance_cm": 1.5
  },
  "body": {
    "chinese_font": "宋体",
    "latin_and_digits_font": "Times New Roman",
    "size_pt": 12,
    "fallback_size_pt_for_dense_pages": null,
    "dense_pages_must_reflow_or_split": true,
    "alignment": "justified",
    "first_line_indent_chars": 2,
    "line_spacing_multiple": 1.25,
    "alternative_fixed_line_spacing_pt": [
      26,
      29
    ],
    "paragraph_before_pt": 0,
    "paragraph_after_pt": 0
  },
  "headings": {
    "level_1": {
      "chinese_font": "黑体",
      "latin_and_digits_font": "Times New Roman",
      "size_pt": 14,
      "bold": true,
      "page_break_before": true,
      "spacing_before_pt": 6,
      "spacing_after_pt": 6
    },
    "level_2": {
      "chinese_font": "宋体",
      "latin_and_digits_font": "Times New Roman",
      "size_pt": 12,
      "bold": true,
      "spacing_before_pt": 6,
      "spacing_after_pt": 0
    },
    "level_3": {
      "chinese_font": "宋体",
      "latin_and_digits_font": "Times New Roman",
      "size_pt": 12,
      "bold": true,
      "spacing_before_pt": 3,
      "spacing_after_pt": 0
    }
  },
  "captions": {
    "figure_position": "below",
    "table_position": "above",
    "alignment": "center",
    "chinese_font": "黑体",
    "latin_and_digits_font": "Times New Roman",
    "size_pt": 9,
    "numbering": "automatic-word-seq-fields",
    "figure_label": "图",
    "table_label": "表",
    "sequence_scope": "whole-document-independent-figure-and-table-sequences",
    "materialize_fields_before_headless_render": true
  },
  "figures": {
    "preferred_format": [
      "SVG",
      "PDF",
      "high-resolution PNG"
    ],
    "placement": "inline",
    "caption_inside_image_forbidden": true,
    "body_lead_in_paragraph_required": true,
    "internal_text_size_at_final_width_pt": 12,
    "textless_image_internal_text_size": null,
    "minimum_raster_dpi_at_final_width": 220,
    "review_zoom_percent": [
      100,
      200
    ]
  },
  "tables": {
    "cell_horizontal_alignment": "center",
    "cell_vertical_alignment": "center",
    "cell_first_line_indent_chars": 0,
    "cell_paragraphs_must_override_body_indent": true
  },
  "table_of_contents": {
    "word_field": true,
    "heading_levels": [1, 2, 3],
    "field_switch": "TOC \\o \"1-3\" \\h \\z \\u",
    "refresh_after_final_pagination": true
  },
  "pagination": {
    "chapter_break_method": "heading-1-page-break-before",
    "manual_page_breaks_forbidden": true,
    "section_breaks_for_pagination_forbidden": true,
    "single_word_section": true
  },
  "sources": {
    "position": "immediately-below-caption-or-table",
    "chinese_font": "宋体",
    "latin_and_digits_font": "Times New Roman",
    "size_pt": 9,
    "alignment": "left"
  },
  "references": {
    "standard": "GB/T 7714-2025",
    "citation_system": "numeric-sequence",
    "layout": "ordinary-paragraph-list",
    "table_layout_forbidden": true,
    "hanging_indent_chars": 2,
    "continuous_numbering_across_subsections": true,
    "url_access_date_required_for_online_sources": true
  },
  "page_number": {
    "blind_review_default": "hidden",
    "non_blind_review_default": "footer-center",
    "field_based": true
  }
}
